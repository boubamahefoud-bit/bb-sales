# ============================================================
# BB Sales (بي بي سيلز) — Environment Configuration
# ============================================================
#
# LOCAL DEVELOPMENT
#   Copy this file to `.env.local` and fill in your values:
#     cp .env.example .env.local
#
#   If these are left empty the app runs in Zero-State Local Mode
#   (in-browser demo with NO fake accounts or figures) so you can
#   preview the full flow. Production always uses Supabase.
#
# VERCEL DEPLOYMENT
#   Add the SAME two variables to your Vercel project:
#     Project Settings > Environment Variables
#   They must be prefixed VITE_ so Vite can expose them to the client.
#   Vercel uses the framework preset `Vite` automatically (build:
#   `npm run build`, output: `dist`). See vercel.json for SPA rewrites.
#
# ============================================================

# Your Supabase project URL (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================
# SUPABASE SETUP (one-time, run in the SQL Editor)
# ============================================================
# Execute the full schema file `supabase/schema.sql` in:
#   Supabase Dashboard > SQL Editor
# It creates: stores, users, trucks_inventory, customers,
# sales_transactions, transaction_items, rep_locations,
# daily_reconciliation, RPCs, Row Level Security, the
# `product-images` storage bucket, and Realtime publications.
# No seed data is inserted — the system starts fully empty.
# ============================================================
